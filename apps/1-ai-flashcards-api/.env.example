# Postgres connection string used by Prisma. Matches docker-compose.yml.
# Copy this file to .env (gitignored) and adjust as needed.
DATABASE_URL="postgresql://flashcards:flashcards@localhost:5433/flashcards?schema=public"

# HTTP port the api listens on (defaults to 4001 if unset).
# PORT=4001

# Integration tests load .env.test (gitignored) first and fall back to this file.
# For a safe, isolated test run, point .env.test at a separate database, e.g.:
#   DATABASE_URL="postgresql://flashcards:flashcards@localhost:5433/flashcards_test?schema=public"
# Create it once with: docker compose up -d && createdb, then `prisma migrate deploy`.
# In CI, DATABASE_URL is provided by the Postgres service container instead.

# Anthropic API key for real AI card generation. REQUIRED for a real run: the api
# fails to start without it (the offline FakeAiCardGenerator is used only when
# NODE_ENV=test or CI=true). Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-sonnet-4-6).
# ANTHROPIC_MODEL="claude-sonnet-4-6"